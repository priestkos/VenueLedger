<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.1.0</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>VenueLedger</AssemblyName>
    <RootNamespace>VenueLedger</RootNamespace>

    <Author>PriestKos</Author>
    <Authors>PriestKos</Authors>
    <Name>VenueLedger</Name>
    <Punchline>Every venue you know, on one clock.</Punchline>
    <Description>Keeps a ledger of FFXIV venues with the details you actually need at the door: location with a one-click Lifestream teleport command, website, Discord, opening and closing times in the venue's own timezone, and notes. Every venue's hours are converted into your own timezone so schedules across venues line up side by side, a live clock reads your system time and timezone, and the whole ledger can be copied or exported to a file.</Description>
    <PackageTags>venue;club;rp;event;timezone;schedule;lifestream;housing</PackageTags>
    <Tags>venue;club;rp;event;timezone;schedule</Tags>
    <RepoUrl>https://github.com/priestkos/VenueLedger</RepoUrl>
  </PropertyGroup>

  <!-- tools/ holds the standalone offline harness; it must never be compiled into the plugin. -->
  <ItemGroup>
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
  </ItemGroup>

</Project>
